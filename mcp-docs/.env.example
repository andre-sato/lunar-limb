# Copie para `.env` (que está no .gitignore) e preencha o que for usar.
# Nenhuma destas variáveis é obrigatória: sem elas o projeto funciona em busca
# lexical e modo só-retrieval.

# Provedor de LLM para o `doc ask` redigir respostas.
ANTHROPIC_API_KEY=

# Serviço de embeddings (endpoint compatível com a API da OpenAI).
DOC_EMBEDDING_API_KEY=
DOC_EMBEDDING_BASE_URL=https://api.openai.com/v1
DOC_EMBEDDING_MODEL=text-embedding-3-small

# Token do MCP Server em modo remoto. Nunca aparece nos logs.
DOC_MCP_TOKEN=

# Servidor remoto. Vazio = servidor local por stdio.
DOC_MCP_SERVER_URL=

# Opcionais de comportamento.
DOC_SEARCH_LIMIT=5
DOC_LLM_MODEL=claude-opus-5
DOC_INDEX_PATH=data/index.json

# `1` passa a registrar o texto das perguntas. Desligado por padrão para o log
# não virar um repositório de perguntas de funcionários.
DOC_LOG_QUERIES=0
