---
/**
 * Rodapé do menu principal: identidade, papel e acesso a Settings (§4).
 *
 * Assim como o botão "Editar esta página", é uma server island: a sidebar da
 * Starlight é pré-renderizada e não pode conhecer o usuário. O link de
 * Settings existe no HTML apenas para quem tem `settings.access`.
 */
import { ROLE_LABELS, can } from '../../lib/auth/permissions';

const user = Astro.locals.user;
const authUser = Astro.locals.authUser;

const initials = user
	? user.name
			.split(/\s+/)
			.filter(Boolean)
			.slice(0, 2)
			.map((word) => word[0])
			.join('')
			.toUpperCase()
	: '';
---

<div class="sidebar-account">
	{
		user ? (
			<>
				{can(authUser, 'settings.access') && (
					<a class="sidebar-account-link" href="/settings">
						<svg viewBox="0 0 24 24" aria-hidden="true" class="sidebar-account-icon">
							<circle cx="12" cy="12" r="3" />
							<path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z" />
						</svg>
						<span>Settings</span>
					</a>
				)}

				<div class="sidebar-account-user">
					<span class="sidebar-account-avatar" aria-hidden="true">
						{initials}
					</span>
					<span class="sidebar-account-identity">
						<strong>{user.name}</strong>
						<span>{ROLE_LABELS[user.role]}</span>
					</span>
				</div>
			</>
		) : (
			<a class="sidebar-account-link" href="/login">
				<span>Entrar</span>
			</a>
		)
	}
</div>

<style>
	.sidebar-account {
		margin-top: 1.5rem;
		padding-top: 0.75rem;
		border-top: 1px solid var(--sl-color-gray-5);
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.sidebar-account-link {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 0.35em 0.5em;
		border-radius: 6px;
		color: var(--sl-color-gray-2);
		text-decoration: none;
		font-size: var(--sl-text-sm);
	}

	.sidebar-account-link:hover {
		color: var(--sl-color-white);
		background: var(--sl-color-gray-6);
	}

	.sidebar-account-icon {
		width: 15px;
		height: 15px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
		flex-shrink: 0;
	}

	.sidebar-account-user {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 0.5em;
	}

	.sidebar-account-avatar {
		width: 26px;
		height: 26px;
		border-radius: 999px;
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
		display: grid;
		place-items: center;
		font-size: 0.7rem;
		font-weight: 700;
		flex-shrink: 0;
	}

	.sidebar-account-identity {
		display: flex;
		flex-direction: column;
		min-width: 0;
		line-height: 1.3;
	}

	.sidebar-account-identity strong {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-white);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.sidebar-account-identity span {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
</style>
