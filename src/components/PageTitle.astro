---
import AiShareDropdown from './AiShareDropdown.astro';
import EditThisPage from './auth/EditThisPage.astro';
import { serverFeatures } from '../config/deploy';
import VersionNotice from './versions/VersionNotice.astro';
// O `starlight-videos` também quer este ponto de override. Como o projeto já o
// usa, ele é composto aqui em vez de disputado — é o que o próprio plugin pede
// no aviso de build.
import VideosPageTitle from 'starlight-videos/components/PageTitle.astro';

const { title, description } = Astro.locals.starlightRoute.entry.data;
const entryFilePath = Astro.locals.starlightRoute.entry.filePath;

// Starlight exposes the local content file path for Content Layer entries.
// Convert it to the path expected by the editor API, which is relative to
// src/content/docs.
const contentRoot = 'src/content/docs/';
const normalizedEntryFilePath = entryFilePath?.replaceAll('\\\\', '/');
const editorPath = normalizedEntryFilePath?.startsWith(contentRoot)
	? normalizedEntryFilePath.slice(contentRoot.length)
	: undefined;

const editLabel =
	Astro.locals.starlightRoute.lang === 'en'
		? 'Edit this page'
		: Astro.locals.starlightRoute.lang === 'es'
			? 'Editar esta página'
			: 'Editar esta página';
---

{/* O aviso vem antes do título: quem chega numa versão obsoleta precisa
    saber disso antes de ler a primeira instrução. */}
<VersionNotice />

<div class="page-title-with-actions">
	<div>
		<h1 id="_top">{title}</h1>
		{description && <p class="page-title-description">{description}</p>}
	</div>

	<div class="page-title-actions">
		{/* server:defer — a página é estática, mas este fragmento é renderizado
		    sob demanda com o cookie da sessão. Viewer e anônimo recebem vazio. */}
		{serverFeatures.editThisPage && (
			<EditThisPage server:defer editorPath={editorPath} label={editLabel} title={title} />
		)}
		<AiShareDropdown />
	</div>
</div>

{/* Metadados de vídeo (`starlight-videos`). */}
<VideosPageTitle />
