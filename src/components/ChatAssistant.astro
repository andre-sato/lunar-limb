---
/**
 * Busca conversacional na documentação.
 *
 * Substitui o antigo `AskAi`, que montava um prompt para o leitor colar em
 * outra ferramenta. Aqui a busca acontece no portal: o cliente desenha a
 * interface e chama `/api/chat/message`; a busca fica no servidor.
 *
 * Cada resposta é um conjunto de **trechos da própria documentação**, com o
 * link da página. Não há modelo de linguagem: nada é redigido nem resumido, e
 * por isso não há como a interface afirmar algo que a documentação não diga.
 *
 * As páginas de documentação são pré-renderizadas, então este componente não
 * pode saber no build quem está lendo. A autenticação é resolvida na primeira
 * mensagem: um 401 vira o convite para entrar, com `next` de volta para a
 * página atual.
 */
interface Props {
	/**
	 * `panel` — aberto na barra lateral, recolhível. É o lugar dele hoje: fica
	 * à vista enquanto se lê, que é quando as dúvidas aparecem.
	 * `dialog` — modal disparado por um botão. Sobrevive para as páginas sem
	 * barra lateral, como a capa, que de outro modo ficariam sem o assistente.
	 */
	variant?: 'panel' | 'dialog';
	/**
	 * Prende o gatilho no canto inferior direito, fora do cabeçalho.
	 *
	 * Vale para as páginas sem barra lateral. No cabeçalho, o botão dividia a
	 * faixa com a busca e sobrava com 99px de largura — cabendo, mas espremido, e
	 * competindo com o controle que a maioria procura primeiro ali. Solto no
	 * canto, ele deixa de disputar espaço e vai para onde um assistente é
	 * procurado.
	 */
	floating?: boolean;
}

const { variant = 'dialog', floating = false } = Astro.props;
const isPanel = variant === 'panel';
// Flutuar só faz sentido no gatilho; o painel já mora na barra lateral.
const isFloating = floating && !isPanel;
const { t } = Astro.locals;
---

<div
	class:list={['doc-chat', isPanel && 'doc-chat--panel', isFloating && 'doc-chat--floating']}
	data-doc-chat
	data-intro={t('chat.intro')}
	data-thinking={t('chat.thinking')}
	data-error={t('chat.error')}
	data-login-required={t('chat.loginRequired')}
	data-login={t('chat.login')}
	data-sources={t('chat.sources')}
	data-open-page={t('chat.openPage')}
	data-feedback-thanks={t('chat.feedbackThanks')}
	data-helpful={t('chat.helpful')}
	data-not-helpful={t('chat.notHelpful')}
>
	{isPanel ? (
		<details class="doc-chat__collapsible" data-chat-collapsible open>
			<summary class="doc-chat__summary">
				<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
					<path d="M21 12a8 8 0 0 1-8 8H7l-4 3v-7a8 8 0 0 1 8-8h2a8 8 0 0 1 8 4Z" />
				</svg>
				<span>{t('chat.title')}</span>
				<svg class="doc-chat__chevron" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="m6 9 6 6 6-6" />
				</svg>
			</summary>

			<div class="doc-chat__panel">
				<div class="doc-chat__messages" data-chat-messages aria-live="polite">
					<div class="doc-chat__message doc-chat__message--assistant">{t('chat.intro')}</div>
				</div>

				<form class="doc-chat__form" data-chat-form>
					<label class="sr-only" for="doc-chat-input">{t('chat.title')}</label>
					<textarea
						id="doc-chat-input"
						name="message"
						rows="2"
						placeholder={t('chat.placeholder')}
						maxlength="500"
						required></textarea>
					<button class="doc-chat__send" type="submit">{t('chat.send')}</button>
				</form>

				<div class="doc-chat__footer">
					<button class="doc-chat__ghost" type="button" data-chat-clear>{t('chat.clear')}</button>
					<p class="doc-chat__disclaimer">{t('chat.disclaimer')}</p>
				</div>
			</div>
		</details>
	) : (
		<Fragment>
		<button class="doc-chat__trigger" type="button" data-chat-open aria-haspopup="dialog">
			<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
				<path d="M21 12a8 8 0 0 1-8 8H7l-4 3v-7a8 8 0 0 1 8-8h2a8 8 0 0 1 8 4Z" />
			</svg>
			<span>{t('chat.trigger')}</span>
		</button>

		<dialog class="doc-chat__dialog" data-chat-dialog aria-labelledby="doc-chat-title">
			<div class="doc-chat__panel">
				<header class="doc-chat__header">
					<div>
						<p class="doc-chat__eyebrow">{t('chat.eyebrow')}</p>
						<h2 id="doc-chat-title">{t('chat.title')}</h2>
					</div>
					<div class="doc-chat__header-actions">
						<button class="doc-chat__ghost" type="button" data-chat-clear>{t('chat.clear')}</button>
						<button class="doc-chat__close" type="button" data-chat-close aria-label={t('chat.close')}>
							<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="m6 6 12 12M18 6 6 18" />
							</svg>
						</button>
					</div>
				</header>

				<div class="doc-chat__messages" data-chat-messages aria-live="polite">
					<div class="doc-chat__message doc-chat__message--assistant">{t('chat.intro')}</div>
				</div>

				<form class="doc-chat__form" data-chat-form>
					<label class="sr-only" for="doc-chat-input">{t('chat.title')}</label>
					<textarea
						id="doc-chat-input"
						name="message"
						rows="2"
						placeholder={t('chat.placeholder')}
						maxlength="500"
						required></textarea>
					<button class="doc-chat__send" type="submit">{t('chat.send')}</button>
				</form>

				<p class="doc-chat__disclaimer">{t('chat.disclaimer')}</p>
			</div>
		</dialog>
		</Fragment>
	)}
</div>

<script>
	const root = document.querySelector<HTMLElement>('[data-doc-chat]');
	if (root) {
		// No painel da barra lateral não existe modal; o resto da lógica é o mesmo.
		const dialog = root.querySelector<HTMLDialogElement>('[data-chat-dialog]');
		const messages = root.querySelector<HTMLElement>('[data-chat-messages]')!;
		const form = root.querySelector<HTMLFormElement>('[data-chat-form]')!;
		const input = form.querySelector<HTMLTextAreaElement>('textarea')!;

		// A classe de escopo que o Astro gera para este componente.
		//
		// Lida do elemento renderizado pelo servidor, nunca escrita à mão: o
		// sufixo muda a cada build. Sem ela, todo nó criado aqui embaixo nasce
		// fora do alcance do CSS — as regras compilam para
		// `.doc-chat__message:where(.astro-XXXX)`, e `createElement` não produz
		// essa classe.
		//
		// O efeito era silencioso e visível ao mesmo tempo: a pergunta
		// recém-digitada aparecia em 16px herdados ao lado de uma introdução de
		// 14px, e os cartões de trecho vinham sem borda nenhuma.
		const scope = [...root.classList].find((name) => name.startsWith('astro-'));

		/**
		 * Marca o nó e tudo dentro dele com a classe de escopo, e o devolve.
		 *
		 * Usada **no ponto de inserção**, não no de criação: um cartão de trecho é
		 * montado em cinco pedaços antes de entrar na árvore, e marcar a subárvore
		 * pronta é um lugar só para lembrar em vez de cinco.
		 */
		function scoped<T extends Element>(node: T): T {
			if (!scope) return node;
			node.classList.add(scope);
			for (const child of node.querySelectorAll('*')) child.classList.add(scope);
			return node;
		}
		const label = (name: string) => root.dataset[name] ?? '';

		let conversationId: string | undefined;
		let busy = false;

		root.querySelector('[data-chat-open]')?.addEventListener('click', () => {
			dialog?.showModal();
			input.focus();
		});
		root.querySelector('[data-chat-close]')?.addEventListener('click', () => dialog?.close());

		// Recolhido ou aberto, a escolha acompanha a navegação. O padrão é
		// aberto: o assistente está na lateral justamente para ficar à vista.
		const collapsible = root.querySelector<HTMLDetailsElement>('[data-chat-collapsible]');
		if (collapsible) {
			const KEY = 'lunar-limb:chat-open';
			try {
				if (window.localStorage.getItem(KEY) === '0') collapsible.open = false;
			} catch {
				// Armazenamento bloqueado: fica no padrão.
			}
			collapsible.addEventListener('toggle', () => {
				try {
					window.localStorage.setItem(KEY, collapsible.open ? '1' : '0');
				} catch {
					// Sem persistir; a sessão atual continua respeitando a escolha.
				}
			});
		}
		root.querySelector('[data-chat-clear]')?.addEventListener('click', () => {
			conversationId = undefined;
			messages.replaceChildren();
			// A introdução volta: uma conversa nova precisa parecer nova.
			append('assistant', root.dataset.intro ?? '');
		});

		function append(role: 'user' | 'assistant' | 'system', text: string): HTMLElement {
			const element = document.createElement('div');
			element.className = `doc-chat__message doc-chat__message--${role}`;
			// `textContent`, nunca `innerHTML`: a frase é do servidor, mas manter
			// a regra em todo lugar é o que impede alguém introduzir HTML aqui
			// depois sem perceber a consequência.
			element.textContent = text;
			messages.append(scoped(element));
			messages.scrollTop = messages.scrollHeight;
			return element;
		}

		interface Source {
			title: string;
			url: string;
		}

		interface Excerpt {
			title: string;
			section?: string;
			text: string;
			url: string;
			score: number;
		}

		function appendExcerpts(excerpts: Excerpt[]): void {
			for (const excerpt of excerpts) {
				const card = document.createElement('article');
				card.className = 'doc-chat__excerpt';

				const heading = document.createElement('p');
				heading.className = 'doc-chat__excerpt-title';
				heading.textContent = excerpt.section
					? `${excerpt.title} — ${excerpt.section}`
					: excerpt.title;
				card.append(heading);

				const body = document.createElement('div');
				body.className = 'doc-chat__excerpt-text';
				// `textContent`, não `innerHTML`: o trecho vem de um arquivo do
				// repositório, e renderizá-lo como HTML daria a qualquer página a
				// chance de executar script no navegador do leitor.
				body.textContent = excerpt.text;
				card.append(body);

				const link = document.createElement('a');
				link.className = 'doc-chat__excerpt-link';
				// Só caminho interno: um link para fora, vindo de conteúdo, seria
				// um destino que ninguém revisou.
				link.href = excerpt.url.startsWith('/') ? excerpt.url : '#';
				link.textContent = label('openPage');
				card.append(link);

				messages.append(scoped(card));
			}
			messages.scrollTop = messages.scrollHeight;
		}

		/**
		 * Links das páginas, ao fim da resposta.
		 *
		 * Cada trecho já tem o seu link, mas eles se repetem quando dois trechos
		 * vêm da mesma página. Esta lista é por página e sem repetição: é o que
		 * o leitor copia ou abre quando quer a fonte inteira, não o recorte.
		 */
		function appendSources(sources: Source[]): void {
			if (sources.length === 0) return;

			const wrapper = document.createElement('nav');
			wrapper.className = 'doc-chat__sources';
			wrapper.setAttribute('aria-label', label('sources'));

			const heading = document.createElement('p');
			heading.className = 'doc-chat__sources-title';
			heading.textContent = label('sources');
			wrapper.append(heading);

			const list = document.createElement('ul');
			for (const source of sources) {
				if (!source.url.startsWith('/')) continue;
				const item = document.createElement('li');
				const link = document.createElement('a');
				link.href = source.url;
				link.textContent = source.title;
				item.append(link);
				list.append(item);
			}

			if (list.childElementCount === 0) return;
			wrapper.append(list);
			messages.append(scoped(wrapper));
			messages.scrollTop = messages.scrollHeight;
		}

		function appendFeedback(messageId: string): void {
			const wrapper = document.createElement('div');
			wrapper.className = 'doc-chat__feedback';

			for (const [value, key] of [
				['up', 'helpful'],
				['down', 'notHelpful'],
			] as const) {
				const button = document.createElement('button');
				button.type = 'button';
				button.className = 'doc-chat__vote';
				button.textContent = value === 'up' ? '👍' : '👎';
				button.title = label(key);
				button.setAttribute('aria-label', label(key));
				button.addEventListener('click', async () => {
					wrapper.textContent = label('feedbackThanks');
					try {
						await fetch('/api/chat/feedback', {
							method: 'POST',
							headers: { 'content-type': 'application/json' },
							body: JSON.stringify({ messageId, conversationId, vote: value }),
						});
					} catch {
						// Retorno de qualidade não vale interromper a leitura.
					}
				});
				wrapper.append(button);
			}

			messages.append(scoped(wrapper));
		}

		function appendLoginPrompt(): void {
			const wrapper = append('system', label('loginRequired'));
			const link = document.createElement('a');
			link.className = 'doc-chat__login';
			link.href = `/login?next=${encodeURIComponent(location.pathname)}`;
			link.textContent = label('login');
			wrapper.append(document.createTextNode(' '));
			wrapper.append(scoped(link));
		}

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (busy) return;

			const question = input.value.trim();
			if (question === '') return;

			busy = true;
			input.value = '';
			append('user', question);
			const pending = append('assistant', label('thinking'));
			pending.classList.add('is-pending');

			try {
				const response = await fetch('/api/chat/message', {
					method: 'POST',
					headers: { 'content-type': 'application/json' },
					// O idioma vem do caminho da página: quem lê em `/en/…`
					// pergunta sobre a documentação em inglês.
					body: JSON.stringify({
						message: question,
						conversationId,
						locale: location.pathname.split('/')[1] ?? '',
					}),
				});

				pending.remove();

				if (response.status === 401) {
					appendLoginPrompt();
					return;
				}

				const data = await response.json().catch(() => null);

				if (!response.ok || !data) {
					append('system', data?.message ?? label('error'));
					return;
				}

				conversationId = data.conversationId;
				append('assistant', data.message);
				appendExcerpts(Array.isArray(data.excerpts) ? data.excerpts : []);
				appendSources(Array.isArray(data.sources) ? data.sources : []);
				// Sem trecho não há o que avaliar.
				if (data.messageId && !data.empty) appendFeedback(data.messageId);
			} catch {
				pending.remove();
				append('system', label('error'));
			} finally {
				busy = false;
				input.focus();
			}
		});
	}
</script>

<style>
	.doc-chat {
		/*
		 * O tamanho do texto da conversa, num lugar só.
		 *
		 * O diálogo do cabeçalho é largo e fica em `sm`; o painel lateral tem
		 * 252px de coluna, onde a mesma medida lê apertada — ele desce um degrau
		 * logo abaixo. A issue #8 pediu a redução; o que a fazia parecer maior
		 * ainda era o defeito de escopo corrigido no script.
		 */
		--doc-chat-text: var(--sl-text-sm);
	}

	.doc-chat__trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.35rem 0.7rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		background: var(--sl-color-black);
		color: var(--sl-color-white);
		font-size: var(--sl-text-xs);
		cursor: pointer;
	}

	.doc-chat__trigger:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-accent-high);
	}

	/*
	 * O gatilho flutuante (issue #6).
	 *
	 * `fixed` no elemento externo, e não no botão: assim o `<dialog>` continua
	 * irmão do gatilho e o `showModal()` segue indo para a camada de topo, sem
	 * herdar posicionamento de ninguém.
	 *
	 * `z-index` abaixo do link de pular para o conteúdo (20) e acima da navegação
	 * (10) — um botão de canto que cobre o skip link tira o atalho de quem navega
	 * por teclado.
	 */
	.doc-chat--floating {
		position: fixed;
		inset-block-end: max(1rem, env(safe-area-inset-bottom));
		inset-inline-end: max(1rem, env(safe-area-inset-right));
		z-index: calc(var(--sl-z-index-navbar, 10) + 1);
	}

	.doc-chat--floating .doc-chat__trigger {
		padding: 0.6rem 1rem;
		font-size: var(--sl-text-sm);
		box-shadow: var(--sl-shadow-md);
		/* Opaco de propósito: ele flutua sobre conteúdo que não conhece. */
		background: var(--sl-color-black);
	}

	.doc-chat--floating .doc-chat__trigger svg {
		width: 1.15rem;
		height: 1.15rem;
	}

	/*
	 * Em tela estreita ele vira um círculo com só o ícone. O rótulo ao lado
	 * ocuparia boa parte da largura, e um botão flutuante que tapa o texto é pior
	 * que um botão sem rótulo — o `aria-label` continua lá para quem não vê o
	 * ícone.
	 */
	@media (max-width: 30rem) {
		.doc-chat--floating .doc-chat__trigger span {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
		}

		.doc-chat--floating .doc-chat__trigger {
			padding: 0.8rem;
			border-radius: 999px;
		}
	}

	.doc-chat__trigger svg {
		width: 1rem;
		height: 1rem;
	}

	.doc-chat__dialog {
		border: none;
		padding: 0;
		background: transparent;
		max-width: min(46rem, 94vw);
		width: 100%;
	}

	.doc-chat__dialog::backdrop {
		background: rgb(0 0 0 / 0.55);
	}

	.doc-chat__panel {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1.25rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		background: var(--sl-color-bg);
		color: var(--sl-color-white);
		max-height: min(80vh, 44rem);
	}

	.doc-chat__header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
	}

	.doc-chat__header h2 {
		margin: 0;
		font-size: var(--sl-text-h4);
	}

	.doc-chat__eyebrow {
		margin: 0;
		font-size: var(--sl-text-xs);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--sl-color-gray-3);
	}

	.doc-chat__header-actions {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.doc-chat__ghost,
	.doc-chat__close {
		border: 1px solid transparent;
		background: none;
		color: var(--sl-color-gray-2);
		cursor: pointer;
		border-radius: 0.4rem;
		font-size: var(--sl-text-xs);
		padding: 0.25rem 0.5rem;
	}

	.doc-chat__ghost:hover,
	.doc-chat__close:hover {
		border-color: var(--sl-color-gray-5);
		color: var(--sl-color-white);
	}

	.doc-chat__close svg {
		width: 1rem;
		height: 1rem;
		display: block;
	}

	/*
	 * Em tela estreita o gatilho fica só com o ícone. Com o rótulo, ele quebrava
	 * em duas linhas e espremia o nome do portal a ponto de sobrar "Sua Em".
	 */
	@media (width <= 42rem) {
		.doc-chat__trigger span {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
		}

		.doc-chat__trigger {
			padding-inline: 0.6rem;
		}
	}

	/* --- Variante de painel, na barra lateral ---------------------------- */

	.doc-chat--panel {
		--doc-chat-text: var(--sl-text-xs);
		display: block;
		margin-block: 1rem 0.5rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.6rem;
		background: var(--sl-color-black);
		overflow: hidden;
	}

	.doc-chat__summary {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.55rem 0.7rem;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-white);
		cursor: pointer;
		list-style: none;
	}

	.doc-chat__summary::-webkit-details-marker {
		display: none;
	}

	.doc-chat__summary svg {
		width: 1em;
		height: 1em;
		flex: none;
	}

	.doc-chat__chevron {
		margin-inline-start: auto;
		transition: transform 0.15s ease;
	}

	.doc-chat__collapsible[open] .doc-chat__chevron {
		transform: rotate(180deg);
	}

	.doc-chat--panel .doc-chat__panel {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 0 0.6rem 0.6rem;
	}

	.doc-chat--panel .doc-chat__messages {
		/* Alto o bastante para uma resposta com trechos, baixo o bastante para
		   a navegação da seção continuar visível acima. */
		max-height: 22rem;
		min-height: 4rem;
		overflow-y: auto;
	}

	.doc-chat--panel .doc-chat__footer {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.doc-chat--panel .doc-chat__disclaimer {
		margin: 0;
		text-align: end;
	}

	.doc-chat__messages {
		flex: 1;
		overflow-y: auto;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding-right: 0.25rem;
		min-height: 8rem;
	}

	.doc-chat__message {
		padding: 0.6rem 0.8rem;
		border-radius: 0.6rem;
