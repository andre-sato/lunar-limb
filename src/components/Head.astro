---
/**
 * `<head>` da Starlight.
 *
 * Este override existe para o portal poder acrescentar coisas ao `<head>` sem
 * mexer no tema. Hoje ele apenas delega — o carregador de analytics de terceiros
 * que morava aqui foi retirado (ADR-0019): a observabilidade do portal é a
 * nativa, que mede no servidor e não injeta script no navegador de quem lê.
 */
import Default from '@astrojs/starlight/components/Head.astro';
---

<Default {...Astro.props}><slot /></Default>
