---
/**
 * Busca do cabeçalho.
 *
 * Dois provedores, escolhidos por ambiente (ver `src/config/search.ts`):
 *
 * - **Algolia DocSearch**, quando há credenciais. Índice hospedado, tolerante a
 *   erro de digitação e com busca em todos os idiomas de uma vez.
 * - **Pagefind**, quando não há. Índice gerado no build, sem serviço externo —
 *   é o que faz o portal funcionar recém-clonado.
 *
 * O assistente de documentação mora na barra lateral, aberto. Aqui ele só
 * aparece nas páginas **sem** barra lateral — a capa —, que de outro modo
 * ficariam sem busca conversacional. É o mesmo componente, na forma de modal.
 *
 * Este override existe porque o `starlight-docsearch` quer o mesmo ponto, e
 * escolher entre os dois provedores tem de acontecer em algum lugar nosso.
 */
import ChatAssistant from './ChatAssistant.astro';
import DefaultSearch from '@astrojs/starlight/components/Search.astro';
import DocSearch from '@astrojs/starlight-docsearch/DocSearch.astro';
import { searchProvider } from '../config/search';
import { serverFeatures } from '../config/deploy';

// Onde há barra lateral, o assistente já está lá — em painel, aberto.
const hasSidebar = Astro.locals.starlightRoute?.hasSidebar ?? false;
---

<div class="header-search-actions">
	{searchProvider === 'algolia' ? <DocSearch {...Astro.props} /> : <DefaultSearch {...Astro.props} />}
	{/* Sem barra lateral, o gatilho sai do cabeçalho e flutua no canto (issue #6). */}
	{serverFeatures.chat && !hasSidebar && <ChatAssistant floating />}
</div>
