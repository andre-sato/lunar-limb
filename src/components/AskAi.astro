---
import { portal } from '../config/portal';

const aiClients = portal.aiClients;
const { t } = Astro.locals;
---

<div
	class="ask-ai"
	data-ask-ai
	data-preparing={t('askAi.preparing')}
	data-copy-success={t('askAi.copySuccess')}
	data-copy-error={t('askAi.copyError')}
	data-system-prompt={t('askAi.systemPrompt')}
	data-scope-prompt={t('askAi.scopePrompt')}
	data-source-prompt={t('askAi.sourcePrompt')}
	data-context-heading={t('askAi.contextHeading')}
	data-question-heading={t('askAi.questionHeading')}
	data-page-label={t('askAi.pageLabel')}
	data-url-label={t('askAi.urlLabel')}
>
	<button class="ask-ai__trigger" type="button" data-ask-ai-trigger aria-haspopup="dialog">
		<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
			<path d="m12 3-1.7 5.3L5 10l5.3 1.7L12 17l1.7-5.3L19 10l-5.3-1.7L12 3Z" />
			<path d="m19 16-.8 2.2L16 19l2.2.8L19 22l.8-2.2L22 19l-2.2-.8L19 16Z" />
		</svg>
		<span>{t('askAi.trigger')}</span>
	</button>

	<dialog class="ask-ai__dialog" data-ask-ai-dialog aria-labelledby="ask-ai-title">
		<div class="ask-ai__panel">
			<header class="ask-ai__header">
				<div>
					<p class="ask-ai__eyebrow">{t('askAi.eyebrow')}</p>
					<h2 id="ask-ai-title">{t('askAi.title')}</h2>
				</div>
				<button class="ask-ai__close" type="button" data-ask-ai-close aria-label={t('askAi.close')}>
					<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="m6 6 12 12M18 6 6 18" />
					</svg>
				</button>
			</header>

			<div class="ask-ai__messages" data-ask-ai-messages aria-live="polite">
				<div class="ask-ai__message ask-ai__message--assistant">
					{t('askAi.intro')}
				</div>
			</div>

			<form class="ask-ai__form" data-ask-ai-form>
				<label for="ask-ai-question">{t('askAi.question')}</label>
				<textarea
					id="ask-ai-question"
					name="question"
					rows="3"
					placeholder={t('askAi.placeholder')}
					required
				></textarea>
				<div class="ask-ai__actions">
					<label class="ask-ai__client-label" for="ask-ai-client">{t('askAi.respondWith')}</label>
					<select id="ask-ai-client" name="client" data-ask-ai-client>
						{aiClients.map((client) => <option value={client.url}>{client.name}</option>)}
					</select>
					<button class="ask-ai__submit" type="submit">{t('askAi.submit')}</button>
				</div>
				<p class="ask-ai__disclaimer" data-ask-ai-status>
					{t('askAi.disclaimer')}
				</p>
			</form>
		</div>
	</dialog>
</div>

<script>
	const contentSelector = '.sl-markdown-content, article, main';

	function getPageContext(root: HTMLElement) {
		const title = document.querySelector('h1')?.textContent?.trim() || document.title;
		const source = document.querySelector<HTMLElement>(contentSelector);
		const content = source?.cloneNode(true) as HTMLElement | undefined;

		content?.querySelectorAll('[data-ai-share], [data-ask-ai], nav, .pagination-links').forEach((element) => {
			element.remove();
		});

		const text = content?.innerText.replace(/\n{3,}/g, '\n\n').trim() || '';
		return `${root.dataset.pageLabel}: ${title}\n${root.dataset.urlLabel}: ${window.location.href}\n\n${text}`.trim();
	}

	function buildPrompt(root: HTMLElement, question: string) {
		return [
			root.dataset.systemPrompt,
			root.dataset.scopePrompt,
			root.dataset.sourcePrompt,
			'',
			`## ${root.dataset.contextHeading}`,
			getPageContext(root),
			'',
			`## ${root.dataset.questionHeading}`,
			question,
		].join('\n');
	}

	async function copyToClipboard(text: string) {
		try {
			await navigator.clipboard.writeText(text);
			return true;
		} catch {
			const textarea = document.createElement('textarea');
			textarea.value = text;
			textarea.setAttribute('readonly', '');
			textarea.style.position = 'fixed';
			textarea.style.opacity = '0';
			document.body.append(textarea);
			textarea.select();
			const copied = document.execCommand('copy');
			textarea.remove();
			return copied;
		}
	}

	function addMessage(messages: HTMLElement, type: 'user' | 'assistant', text: string) {
		const message = document.createElement('div');
		message.className = `ask-ai__message ask-ai__message--${type}`;
		message.textContent = text;
		messages.append(message);
		messages.scrollTop = messages.scrollHeight;
	}

	document.querySelectorAll<HTMLElement>('[data-ask-ai]').forEach((root) => {
		const trigger = root.querySelector<HTMLButtonElement>('[data-ask-ai-trigger]');
		const dialog = root.querySelector<HTMLDialogElement>('[data-ask-ai-dialog]');
		const close = root.querySelector<HTMLButtonElement>('[data-ask-ai-close]');
		const form = root.querySelector<HTMLFormElement>('[data-ask-ai-form]');
		const question = root.querySelector<HTMLTextAreaElement>('[name="question"]');
		const client = root.querySelector<HTMLSelectElement>('[data-ask-ai-client]');
		const messages = root.querySelector<HTMLElement>('[data-ask-ai-messages]');
		const status = root.querySelector<HTMLElement>('[data-ask-ai-status]');

		trigger?.addEventListener('click', () => {
			if (!dialog) return;
			if (typeof dialog.showModal === 'function') dialog.showModal();
			else dialog.setAttribute('open', '');
			question?.focus();
		});

		close?.addEventListener('click', () => dialog?.close());

		dialog?.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});

		form?.addEventListener('submit', async (event) => {
			event.preventDefault();
			const questionText = question?.value.trim();
			const clientUrl = client?.value;
			if (!questionText || !clientUrl || !messages) return;

			addMessage(messages, 'user', questionText);
			addMessage(messages, 'assistant', root.dataset.preparing || '');
			window.open(clientUrl, '_blank', 'noopener,noreferrer');

			const copied = await copyToClipboard(buildPrompt(root, questionText));
			if (status) {
				status.textContent = copied
					? root.dataset.copySuccess
					: root.dataset.copyError;
			}
			if (question) question.value = '';
		});
	});
</script>
