# Portal de desenvolvimento — variáveis de ambiente (exemplo)
# Copie para .env e preencha com valores reais. Este arquivo é versionado.

# --- Autenticação ---------------------------------------------------------
# Obrigatória em produção: chave HMAC para sessões (mínimo 32 caracteres).
# Gere com: openssl rand -base64 48
# Sem ela, uma chave é gerada em data/secret (apenas local).
AUTH_SECRET=

# Cria o primeiro admin no primeiro request (opcional — sem estas variáveis
# o primeiro acesso gera um admin e imprime a senha uma única vez no console).
PORTAL_ADMIN_EMAIL=
PORTAL_ADMIN_PASSWORD=

# --- URL pública -----------------------------------------------------------
# Usada pelo sitemap e pelo registro OpenSearch (busca "warp"); precisa ser
# absoluta, senão o sitemap é ignorado e o build do OpenSearch falha.
SITE_URL=https://docs.suaempresa.com

# --- Alvo de deploy --------------------------------------------------------
# `server` (padrão) ou `pages` (GitHub Pages — sem servidor Node).
PORTAL_TARGET=server

# Diretório de dados (usuários, sessões, auditoria). Útil para subir uma
# instância de verificação sem tocar nos usuários reais.
PORTAL_DATA_DIR=data

# Subcaminho para site de projeto no GitHub Pages (ex.: /lunar-limb).
# Vazio/`/` para site de usuário/organização ou domínio próprio.
# PAGES_BASE=/lunar-limb

# --- Servidor standalone (npm run build && node dist/server/entry.mjs) -----
HOST=0.0.0.0
PORT=4321

# --- Analytics (Do11y + Supabase) — opcional ------------------------------
# DO11Y_ENABLED=false
# DO11Y_SUPABASE_URL=
# DO11Y_SUPABASE_KEY=
# DO11Y_SERVICE_ROLE_KEY=
# DO11Y_TABLE=

# --- Busca (Algolia DocSearch) — opcional ---------------------------------
# Com as três preenchidas, a busca do portal passa a ser o Algolia DocSearch.
# Sem elas, continua o Pagefind, que é gerado no build e não depende de
# serviço externo.
#
# Use a chave **Search-Only**: ela é pública por natureza, vai para o
# navegador e só lê o índice. A chave de Admin escreve no índice e nunca
# deve aparecer aqui.
# ALGOLIA_APP_ID=
# ALGOLIA_SEARCH_API_KEY=
# ALGOLIA_INDEX_NAME=

# --- Workflow de Git — opcional -------------------------------------------
# Com um token, o editor cria o pull request direto. Sem ele, abre a tela de
# comparação do provedor com tudo preenchido.
# Escopo mínimo: `repo` (ou `pull_requests: write` em token de granularidade
# fina). O token fica no ambiente, nunca no repositório.
# GITHUB_TOKEN=

# --- Assistente de documentação — opcional ---------------------------------
# Com a chave, o assistente redige a resposta a partir dos trechos recuperados.
# Sem ela, devolve os trechos e as fontes — que é o modo padrão e o único que
# não tem como inventar nada.
# A chave fica no ambiente, nunca em arquivo de configuração: um segredo em
# configuração acaba num backup, num log ou numa resposta de API.
# ANTHROPIC_API_KEY=
